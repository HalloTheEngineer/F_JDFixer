<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>JDFixer</AssemblyName>
    <RootNamespace>JDFixer</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <CopyPDB>true</CopyPDB>
    <GenerateManifest>false</GenerateManifest>
    <BSMTProjectType>BSIPA</BSMTProjectType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The test project lives inside the repo but must not be compiled into the plugin. -->
  <ItemGroup>
    <Compile Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
  </ItemGroup>

  <!-- Beat Saber install location. Override on the command line, e.g.
       dotnet build -p:GameDirectory=/path/to/BeatSaber/ -->
  <PropertyGroup>
    <GameDirectory Condition="'$(GameDirectory)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Beat Saber\</GameDirectory>
    <RefAsmDir>$(GameDirectory)Beat Saber_Data\Managed</RefAsmDir>
    <LibsDir>$(GameDirectory)Libs</LibsDir>
    <PluginsDir>$(GameDirectory)Plugins</PluginsDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BeatSaberModdingTools.Tasks" Version="2.0.0-beta4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(LibsDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BGLib.UnityExtension">
      <HintPath>$(RefAsmDir)\BGLib.UnityExtension.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BSML">
      <HintPath>$(PluginsDir)\BSML.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Base class of StandardLevelScenesTransitionSetupDataSO, so reflection over it needs this. -->
    <Reference Include="BGLib.AppFlow">
      <HintPath>$(RefAsmDir)\BGLib.AppFlow.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BeatSaber.ViewSystem">
      <HintPath>$(RefAsmDir)\BeatSaber.ViewSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BeatmapCore">
      <HintPath>$(RefAsmDir)\BeatmapCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Core">
      <HintPath>$(RefAsmDir)\Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DataModels">
      <HintPath>$(RefAsmDir)\DataModels.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GameplayCore">
      <HintPath>$(RefAsmDir)\GameplayCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HMUI">
      <HintPath>$(RefAsmDir)\HMUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="IPA.Loader">
      <HintPath>$(RefAsmDir)\IPA.Loader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Main">
      <HintPath>$(RefAsmDir)\Main.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SiraUtil">
      <HintPath>$(PluginsDir)\SiraUtil.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(RefAsmDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RefAsmDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(RefAsmDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(RefAsmDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Zenject">
      <HintPath>$(RefAsmDir)\Zenject.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Zenject.dll type-forwards the Zenject namespace; both are required. -->
    <Reference Include="Zenject-usage">
      <HintPath>$(RefAsmDir)\Zenject-usage.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="manifest.json" />
    <EmbeddedResource Include="UI\BSML\*.bsml" />
  </ItemGroup>

</Project>
